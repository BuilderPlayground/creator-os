<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Creator OS helps creators organize brand deals, track opportunities, and stay on top of payments.">
  <title>Creator OS | Your Creator Business, Organized</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body class="landing-page">

  <!-- Navigation -->
  <header class="landing-nav">
    <a href="/" class="landing-logo">
      <span class="landing-logo-icon">✳</span>
      <span>CREATOR OS</span>
    </a>

    <nav class="landing-nav-links" aria-label="Main navigation">
      <a href="/login" class="landing-signin">Sign in</a>
      <a href="/signup" class="landing-nav-cta">Get started ↗</a>
    </nav>
  </header>

  <main>

    <!-- Hero -->
    <section class="landing-hero">

      <div class="landing-hero-content">
        <div class="landing-eyebrow">
          THE BUSINESS SIDE OF CREATING, SIMPLIFIED.
        </div>

        <h1>
          Create freely.<br>
          <span>Operate boldly.</span>
        </h1>

        <p class="landing-hero-description">
          Your creativity is the business.
          Creator OS helps you run it.
          Organize brand partnerships, track opportunities,
          and stay on top of your money—all in one workspace.
        </p>

        <div class="landing-hero-actions">
          <a href="/signup" class="landing-primary-button">
            Create your workspace <span>↗</span>
          </a>

          <a href="/login" class="landing-secondary-button">
            I already have an account →
          </a>
        </div>

        <p class="landing-hero-note">
          LESS ADMIN. MORE CREATING. BETTER BUSINESS.
        </p>
      </div>

      <!-- Product Preview -->
      <div class="landing-preview">

        <div class="landing-preview-header">
          <div class="landing-preview-brand">
            <span class="landing-preview-icon">✳</span>
            CREATOR OS
          </div>

          <span class="landing-preview-label">WORKSPACE PREVIEW</span>
        </div>

        <div class="landing-preview-body">

          <p class="landing-preview-eyebrow">
            YOUR CREATOR WORKSPACE
          </p>

          <h2>Make moves.<br>Get paid.</h2>

          <p class="landing-preview-description">
            Your business, at a glance.
          </p>

          <div class="landing-preview-stats">

            <div class="landing-preview-stat">
              <span>ACTIVE DEALS</span>
              <strong>04</strong>
            </div>

            <div class="landing-preview-stat lavender">
              <span>PIPELINE VALUE</span>
              <strong>$18.5K</strong>
            </div>

            <div class="landing-preview-stat lime">
              <span>PAYMENTS RECEIVED</span>
              <strong>$7.5K</strong>
            </div>

          </div>

          <div class="landing-preview-deal">
            <div>
              <span class="landing-preview-deal-label">
                BRAND PARTNERSHIP
              </span>
              <h3>Your next big collaboration.</h3>
              <p>From inquiry to invoice.</p>
            </div>

            <span class="landing-preview-deal-arrow">↗</span>
          </div>

        </div>

        <div class="landing-preview-footer">
          BUILT FOR CREATORS WHO MEAN BUSINESS.
        </div>

      </div>

    </section>

    <!-- Value Proposition -->
    <section class="landing-features">

      <div class="landing-section-heading">
        <p class="landing-section-eyebrow">
          YOUR BUSINESS. YOUR TERMS.
        </p>

        <h2>
          More creating.<br>
          Less keeping up.
        </h2>

        <p>
          Your ideas deserve more than scattered spreadsheets,
          missed follow-ups, and mental notes.
        </p>
      </div>

      <div class="landing-feature-grid">

        <article class="landing-feature-card">
          <div class="landing-feature-number">01 /</div>
          <div class="landing-feature-icon">↗</div>

          <h3>Track every opportunity.</h3>

          <p>
            Keep brand inquiries, negotiations, and partnerships
            organized from the first conversation onward.
          </p>
        </article>

        <article class="landing-feature-card">
          <div class="landing-feature-number">02 /</div>
          <div class="landing-feature-icon">◎</div>

          <h3>Know where things stand.</h3>

          <p>
            Manage campaign details, deadlines, and deal stages
            without losing track of what's next.
          </p>
        </article>

        <article class="landing-feature-card">
          <div class="landing-feature-number">03 /</div>
          <div class="landing-feature-icon">✳</div>

          <h3>Keep your money in view.</h3>

          <p>
            Track deal values and payment statuses so you can
            see what's in your pipeline and what's been paid.
          </p>
        </article>

      </div>

    </section>

    <!-- Closing CTA -->
    <section class="landing-final-cta">

      <div>
        <p class="landing-section-eyebrow">
          FROM PITCH TO PAYCHECK.
        </p>

        <h2>You're the talent.<br>Be the business, too.</h2>

        <p>
          Build a more organized foundation for the business
          behind your creativity.
        </p>
      </div>

      <a href="/signup" class="landing-final-button">
        Get started ↗
      </a>

    </section>

  </main>

  <!-- Footer -->
  <footer class="landing-footer">

    <div class="landing-logo">
      <span class="landing-logo-icon">✳</span>
      <span>CREATOR OS</span>
    </div>

    <p>Your work. Your business. Your way.</p>

  </footer>

</body>
</html>
